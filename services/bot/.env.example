# Токен тестового бота игры от @BotFather — не фото-бота. Один токен нельзя слушать из двух мест:
# пока этот бот работает на Railway, локально его не запускать.
BOT_TOKEN=

# Адрес Mini App — публичный домен web. На Railway: https://${{web.RAILWAY_PUBLIC_DOMAIN}}.
WEB_APP_URL=https://example.up.railway.app

# api: локально — http://localhost:8000; на Railway — http://${{api.RAILWAY_PRIVATE_DOMAIN}}:${{api.PORT}}.
API_URL=http://localhost:8000

# Тот же секрет, что у api. На Railway: ${{api.INTERNAL_SECRET}}.
INTERNAL_SECRET=

DEBUG=true
