# Локальный Postgres из docker-compose.yml в корне репозитория.
# На Railway — ссылка на переменную Postgres: ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgresql://gnezdo:gnezdo@localhost:5432/gnezdo

# true — подробные логи, /api/docs и схема OpenAPI, подставные пользователи, отладочная панель.
DEBUG=true

# Токен тестового бота игры. Без него (только с DEBUG) api работает без Telegram:
# вход — подставными пользователями, ссылок-приглашений нет, уведомления не уходят.
# api бот не опрашивает, поэтому этот токен можно держать здесь, пока bot работает на Railway.
# BOT_TOKEN=

# Общий секрет с bot для подтверждения входа в PWA. На Railway у bot — ссылка: ${{api.INTERNAL_SECRET}}.
# INTERNAL_SECRET=

# false — новые пары не создаются, собранные играют дальше.
# NEW_PAIRS=true

# По умолчанию 8000 — так же, как на Railway.
# PORT=8000
