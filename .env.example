# Токен от @BotFather. Для локального запуска — токен отдельного тестового бота.
BOT_TOKEN=

# Часовой пояс новых пар; каждая пара может сменить свой в /settings.
TIMEZONE=Europe/Moscow

# false — бот не принимает новые пары (собранные играют дальше).
NEW_PAIRS=true

# true включает /dev — служебные кнопки для ручной проверки.
DEBUG=true

# По умолчанию data/bot.db (на Railway это /app/data/bot.db на Volume).
# DB_PATH=data/bot.db
